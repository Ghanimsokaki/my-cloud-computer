{
  "name": "High Performance Cloud Computer (Linux) + Gemby agent",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "VARIANT": "ubuntu-24.04"
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {},
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/ssh:1": {},
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "rust-lang.rust-analyzer",
        "ms-python.python",
        "golang.Go"
      ]
    }
  },
  "remoteUser": "codespace",
  "remoteEnv": {
    "PATH": "/home/codespace/.local/bin:${containerEnv:PATH}"
  },
  "postCreateCommand": "bash -lc 'cd /workspaces/my-cloud-computer && python3 -m pip install --user torch --index-url https://download.pytorch.org/whl/cpu && python3 -m pip install --user -r gemby/requirements.txt && mkdir -p ~/.local/bin && ln -sf /workspaces/my-cloud-computer/gemby/gemby.py ~/.local/bin/gemby && chmod +x /workspaces/my-cloud-computer/gemby/gemby.py'",
  "mounts": [
    "source=/tmp/cache,target=/tmp/cache,type=bind,consistency=cached"
  ],
  "containerEnv": {
    "MAKEFLAGS": "-j$(nproc)",
    "CCACHE_DIR": "/tmp/cache/.ccache"
  },
  "forwardPorts": [8080, 3000, 5000, 8000],
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "64gb"
  },
  "runArgs": [
    "--init",
    "--cap-add=SYS_PTRACE",
    "--security-opt", "seccomp=unconfined",
    "--shm-size=2g"
  ]
}
